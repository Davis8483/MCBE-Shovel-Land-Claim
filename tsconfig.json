    "target": "es2020",
    "module": "es2020",
    "lib": ["es2020", "dom"],
    "sourceMap": true,
    "outDir": "scripts/",
    "rootDir": "./dist/scripts",
    "moduleResolution": "bundler",
    "strict": false,
    "skipLibCheck": true,
    "ignoreDeprecations": "5.0"
  }
